generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MAIN_BROKER
  REFERRAL_BROKER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum OtpPurpose {
  REGISTER
  LOGIN
  RESET
}

model User {
  id              String        @id @default(cuid())
  email           String?       @unique
  phoneOriginal   String
  phoneNormalized String        @unique
  passwordHash    String?
  role            Role
  status          UserStatus    @default(PENDING)
  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  consentAt       DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  brokerProfile  BrokerProfile?
  sessions       Session[]
  otpChallenges  OtpChallenge[]
  passwordSetupTokens PasswordSetupToken[]
  ownedCustomers Customer[] @relation("OwnedCustomers")
  createdCustomers Customer[] @relation("CreatedCustomers")
  submittedLeads Lead[] @relation("SubmittedLeads")
  assignedLeads Lead[] @relation("AssignedLeads")
  statusChanges LeadStatusHistory[] @relation("StatusChangedBy")
  decidedDuplicates DuplicateReview[] @relation("DecidedDuplicates")
  createdProperties Property[] @relation("CreatedProperties")
  auditLogs AuditLog[] @relation("AuditActor")

  @@index([role, status])
}

model PasswordSetupToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model BrokerProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  brokerCode String   @unique
  fullName   String
  city       String?
  company    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id            String   @id @default(cuid())
  userId        String
  tokenHash     String   @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  rotatedFromId String?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OtpChallenge {
  id           String     @id @default(cuid())
  userId       String?
  phone        String
  purpose      OtpPurpose
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int        @default(0)
  createdAt    DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, purpose])
  @@index([expiresAt])
}

model PendingRegistration {
  id          String   @id @default(cuid())
  phone       String   @unique
  fullName    String
  email       String?
  role        Role
  consentAt   DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  SITE_VISIT
  NEGOTIATION
  CONVERTED
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DuplicateStatus {
  PENDING
  LINKED
  DISTINCT_APPROVED
  REJECTED
}

enum ListingType {
  SALE
  RENT
  LEASE
}

enum PropertyType {
  APARTMENT
  VILLA
  HOUSE
  PLOT
  COMMERCIAL
  OFFICE
  SHOP
  LAND
  OTHER
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  SOLD
  RENTED
  ARCHIVED
}

model Customer {
  id              String   @id @default(cuid())
  customerCode    String   @unique
  fullName        String
  phoneOriginal   String
  phoneNormalized String
  email           String?
  address         String?
  city            String?
  ownerBrokerId   String?
  ownerBroker     User?    @relation("OwnedCustomers", fields: [ownerBrokerId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User     @relation("CreatedCustomers", fields: [createdById], references: [id], onDelete: Restrict)
  consentAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  leads               Lead[]
  duplicateCandidates DuplicateReview[] @relation("CandidateCustomer")

  @@index([phoneNormalized])
  @@index([createdById])
  @@index([ownerBrokerId])
}

model Property {
  id                 String         @id @default(cuid())
  propertyCode       String         @unique
  title              String
  type               PropertyType   @default(APARTMENT)
  listingType        ListingType    @default(SALE)
  address            String?
  city               String
  locality           String?
  price              Int
  priceMin           Int?
  priceMax           Int?
  area               Float?
  areaUnit           String         @default("sq.ft.")
  bedrooms           Int?
  bathrooms          Int?
  furnishing         String?
  description        String?
  status             PropertyStatus @default(ACTIVE)
  verificationStatus String         @default("UNVERIFIED")
  ownerContact       String?
  imageKeys          Json           @default("[]")
  createdById        String?
  createdBy          User?          @relation("CreatedProperties", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  leads Lead[]

  @@index([status])
  @@index([city])
  @@index([listingType])
}

model Lead {
  id                String       @id @default(cuid())
  leadCode          String       @unique
  customerId        String
  customer          Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  submittedById     String
  submittedBy       User         @relation("SubmittedLeads", fields: [submittedById], references: [id], onDelete: Restrict)
  source            String       @default("REFERRAL")
  propertyId        String?
  property          Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  budgetMin         Int?
  budgetMax         Int?
  preferredLocation String?
  requirements      String?
  notes             String?
  status            LeadStatus   @default(NEW)
  priority          LeadPriority @default(MEDIUM)
  assignedToId      String?
  assignedTo        User?        @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  nextFollowUpAt    DateTime?
  convertedAt       DateTime?
  lostAt            DateTime?
  lostReason        String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  history         LeadStatusHistory[]
  duplicateReview DuplicateReview?

  @@index([customerId])
  @@index([submittedById])
  @@index([assignedToId])
  @@index([status])
  @@index([propertyId])
}

model LeadStatusHistory {
  id          String     @id @default(cuid())
  leadId      String
  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStatus  LeadStatus?
  toStatus    LeadStatus
  changedById String
  changedBy   User       @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  reason      String?
  createdAt   DateTime   @default(now())

  @@index([leadId])
}

model DuplicateReview {
  id                  String          @id @default(cuid())
  leadId              String          @unique
  lead                Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  candidateCustomerId String
  candidateCustomer   Customer        @relation("CandidateCustomer", fields: [candidateCustomerId], references: [id], onDelete: Restrict)
  status              DuplicateStatus @default(PENDING)
  decidedById         String?
  decidedBy           User?           @relation("DecidedDuplicates", fields: [decidedById], references: [id], onDelete: SetNull)
  reason              String?
  decidedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  summary    String?
  requestId  String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
