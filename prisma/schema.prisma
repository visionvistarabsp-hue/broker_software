generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MAIN_BROKER
  REFERRAL_BROKER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum OtpPurpose {
  REGISTER
  LOGIN
  RESET
}

model User {
  id              String     @id @default(cuid())
  email           String?    @unique
  
  passwordHash    String?
  role            Role
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime?
  consentAt       DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  brokerProfile       BrokerProfile?
  sessions            Session[]
  otpChallenges       OtpChallenge[]
  passwordSetupTokens PasswordSetupToken[]
  ownedCustomers      Customer[]           @relation("OwnedCustomers")
  createdCustomers    Customer[]           @relation("CreatedCustomers")
  submittedLeads      Lead[]               @relation("SubmittedLeads")
  assignedLeads       Lead[]               @relation("AssignedLeads")
  statusChanges       LeadStatusHistory[]  @relation("StatusChangedBy")
  decidedDuplicates   DuplicateReview[]    @relation("DecidedDuplicates")
  createdProperties   Property[]           @relation("CreatedProperties")
  auditLogs           AuditLog[]           @relation("AuditActor")
  assignedFollowUps   FollowUp[]           @relation("AssignedFollowUps")
  createdFollowUps    FollowUp[]           @relation("CreatedFollowUps")
  createdSiteVisits   SiteVisit[]          @relation("CreatedSiteVisits")
  notifications       Notification[]
  payoutsAsPayee      Payout[]             @relation("PayoutPayee")
  decidedPayouts      Payout[]             @relation("PayoutDecider")
  collaborations      DealCollaborator[]   @relation("Collaborations")
  addedCollaborators  DealCollaborator[]   @relation("AddedCollaborators")
  propertyDocuments   PropertyDocument[]   @relation("PropertyDocument")
  commissionRules     CommissionRule[]     @relation("CommissionRule")
  commissions         Commission[]         @relation("Commission")
  payoutHistory       PayoutHistory[]      @relation("PayoutHistory")

  @@index([role, status])
}

model PasswordSetupToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model BrokerProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  brokerCode String   @unique
  fullName   String
  city       String?
  company    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  rotatedFromId String?
  ip            String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OtpChallenge {
  id           String     @id @default(cuid())
  userId       String?
  email        String
  purpose      OtpPurpose
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int        @default(0)
  createdAt    DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([expiresAt])
}

model PendingRegistration {
  id        String   @id @default(cuid())
  email     String   @unique
  fullName  String
  role      Role
  consentAt DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  SITE_VISIT
  NEGOTIATION
  CONVERTED
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DuplicateStatus {
  PENDING
  LINKED
  DISTINCT_APPROVED
  REJECTED
}

enum ListingType {
  SALE
  RENT
  LEASE
}

enum PropertyType {
  APARTMENT
  VILLA
  HOUSE
  PLOT
  COMMERCIAL
  OFFICE
  SHOP
  LAND
  OTHER
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  SOLD
  RENTED
  ARCHIVED
}

model Customer {
  id              String    @id @default(cuid())
  customerCode    String    @unique
  fullName        String
  phoneOriginal   String
  phoneNormalized String
  email           String?
  address         String?
  city            String?
  ownerBrokerId   String?
  ownerBroker     User?     @relation("OwnedCustomers", fields: [ownerBrokerId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User      @relation("CreatedCustomers", fields: [createdById], references: [id], onDelete: Restrict)
  consentAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  leads               Lead[]
  duplicateCandidates DuplicateReview[] @relation("CandidateCustomer")

  @@index([phoneNormalized])
  @@index([createdById])
  @@index([ownerBrokerId])
}

model Property {
  id                 String         @id @default(cuid())
  propertyCode       String         @unique
  title              String
  type               PropertyType   @default(APARTMENT)
  listingType        ListingType    @default(SALE)
  address            String?
  city               String
  locality           String?
  price              Int
  priceMin           Int?
  priceMax           Int?
  area               Float?
  areaUnit           String         @default("sq.ft.")
  bedrooms           Int?
  bathrooms          Int?
  furnishing         String?
  description        String?
  status             PropertyStatus @default(ACTIVE)
  verificationStatus String         @default("UNVERIFIED")
  ownerContact       String?
  imageKeys          Json           @default("[]")
  createdById        String?
  createdBy          User?          @relation("CreatedProperties", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  leads      Lead[]
  siteVisits SiteVisit[]
  documents  PropertyDocument[]

  @@index([status])
  @@index([city])
  @@index([listingType])
}

model Lead {
  id                String       @id @default(cuid())
  leadCode          String       @unique
  customerId        String
  customer          Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  submittedById     String
  submittedBy       User         @relation("SubmittedLeads", fields: [submittedById], references: [id], onDelete: Restrict)
  source            String       @default("REFERRAL")
  propertyId        String?
  property          Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  budgetMin         Int?
  budgetMax         Int?
  preferredLocation String?
  requirements      String?
  notes             String?
  status            LeadStatus   @default(NEW)
  priority          LeadPriority @default(MEDIUM)
  assignedToId      String?
  assignedTo        User?        @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  nextFollowUpAt    DateTime?
  convertedAt       DateTime?
  lostAt            DateTime?
  lostReason        String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  history         LeadStatusHistory[]
  duplicateReview DuplicateReview?
  followUps       FollowUp[]
  siteVisits      SiteVisit[]
  notifications   Notification[]
  commission      Commission?
  collaborators   DealCollaborator[]

  @@index([customerId])
  @@index([submittedById])
  @@index([assignedToId])
  @@index([status])
  @@index([propertyId])
}

model LeadStatusHistory {
  id          String      @id @default(cuid())
  leadId      String
  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStatus  LeadStatus?
  toStatus    LeadStatus
  changedById String
  changedBy   User        @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  reason      String?
  createdAt   DateTime    @default(now())

  @@index([leadId])
}

model DuplicateReview {
  id                  String          @id @default(cuid())
  leadId              String          @unique
  lead                Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  candidateCustomerId String
  candidateCustomer   Customer        @relation("CandidateCustomer", fields: [candidateCustomerId], references: [id], onDelete: Restrict)
  status              DuplicateStatus @default(PENDING)
  decidedById         String?
  decidedBy           User?           @relation("DecidedDuplicates", fields: [decidedById], references: [id], onDelete: SetNull)
  reason              String?
  decidedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  summary    String?
  requestId  String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum SiteVisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum NotificationType {
  FOLLOWUP_DUE
  FOLLOWUP_OVERDUE
  LEAD_STATUS
  DUPLICATE
  ASSIGNMENT
  SYSTEM
}

enum DocStatus {
  PENDING
  COMPLETED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

model FollowUp {
  id                String         @id @default(cuid())
  leadId            String
  lead              Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  dueAt             DateTime
  priority          LeadPriority   @default(MEDIUM)
  assignedToId      String?
  assignedTo        User?          @relation("AssignedFollowUps", fields: [assignedToId], references: [id], onDelete: SetNull)
  status            FollowUpStatus @default(PENDING)
  completedAt       DateTime?
  completionNotes   String?
  rescheduleHistory Json           @default("[]")
  createdById       String
  createdBy         User           @relation("CreatedFollowUps", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([leadId])
  @@index([dueAt])
  @@index([status])
  @@index([assignedToId])
}

model SiteVisit {
  id          String          @id @default(cuid())
  leadId      String
  lead        Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyId  String?
  property    Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  scheduledAt DateTime
  status      SiteVisitStatus @default(SCHEDULED)
  notes       String?
  createdById String
  createdBy   User            @relation("CreatedSiteVisits", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([leadId])
  @@index([scheduledAt])
  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  leadId    String?
  lead      Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  readAt    DateTime?
  dedupeKey String?          @unique
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([readAt])
}

model PropertyDocument {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label       String
  status      DocStatus @default(PENDING)
  notes       String?
  fileKey     String?
  createdById String
  createdBy   User      @relation("PropertyDocument", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([propertyId])
}

model CommissionRule {
  id                 String       @id @default(cuid())
  name               String
  percentBasisPoints Int
  appliesTo          ListingType?
  minAmount          Int?
  maxAmount          Int?
  active             Boolean      @default(true)
  createdById        String
  createdBy          User         @relation("CommissionRule", fields: [createdById], references: [id], onDelete: Restrict)
  commissions        Commission[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Commission {
  id                 String          @id @default(cuid())
  leadId             String          @unique
  lead               Lead            @relation(fields: [leadId], references: [id], onDelete: Restrict)
  dealAmount         Int
  ruleId             String?
  rule               CommissionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  percentBasisPoints Int
  computedAmount     Int
  createdById        String
  createdBy          User            @relation("Commission", fields: [createdById], references: [id], onDelete: Restrict)
  payouts            Payout[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([leadId])
}

model Payout {
  id               String          @id @default(cuid())
  commissionId     String
  commission       Commission      @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  payeeBrokerId    String
  payeeBroker      User            @relation("PayoutPayee", fields: [payeeBrokerId], references: [id], onDelete: Restrict)
  shareBasisPoints Int
  amount           Int
  status           PayoutStatus    @default(PENDING)
  reason           String?
  decidedById      String?
  decidedBy        User?           @relation("PayoutDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt        DateTime?
  history          PayoutHistory[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([commissionId])
  @@index([payeeBrokerId])
  @@index([status])
}

model PayoutHistory {
  id          String        @id @default(cuid())
  payoutId    String
  payout      Payout        @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  fromStatus  PayoutStatus?
  toStatus    PayoutStatus
  changedById String
  changedBy   User          @relation("PayoutHistory", fields: [changedById], references: [id], onDelete: Restrict)
  reason      String?
  createdAt   DateTime      @default(now())

  @@index([payoutId])
}

model DealCollaborator {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  brokerId  String
  broker    User     @relation("Collaborations", fields: [brokerId], references: [id], onDelete: Cascade)
  role      String   @default("CO_BROKER")
  addedById String
  addedBy   User     @relation("AddedCollaborators", fields: [addedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([leadId, brokerId])
  @@index([leadId])
  @@index([brokerId])
}
