# connection_limit=1 avoids exhausting Postgres connections under Vercel serverless.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&connection_limit=1"
APP_URL="http://localhost:3000"
SESSION_COOKIE_NAME="broker_session"
SESSION_TTL_HOURS="720"
OTP_TTL_MINUTES="10"
OTP_MAX_ATTEMPTS="5"
# "console" (development only) or "smtp"
OTP_PROVIDER="smtp"
# Format: smtps://USER:APP_PASSWORD@smtp.gmail.com:465 (Gmail: App Password, not account password)
SMTP_URL="smtps://USER:APP_PASSWORD@smtp.gmail.com:465"
SMTP_FROM="no-reply@example.com"
# Optional: force a fixed OTP during local development only. Never set in production.
DEV_OTP_CODE=""
# Shared secret required by GET /api/cron/follow-ups via "Authorization: Bearer <CRON_SECRET>".
# The endpoint is disabled whenever this is empty.
CRON_SECRET=""
# Admin bootstrap seed (npm run db:seed). Set ADMIN_PASSWORD to a strong value locally.
ADMIN_PHONE="+91XXXXXXXXXX"
ADMIN_EMAIL="admin@example.com"
# Use a strong password in production; weak values are rejected nowhere yet — pick wisely.
ADMIN_PASSWORD="CHANGE_ME_strong_password"
